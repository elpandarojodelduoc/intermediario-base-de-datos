### obtener todas las categorias
GET http://localhost:8080/categoria HTTP/1.1
content-type: application/json

### obtener todos los productos
GET http://localhost:8080/producto HTTP/1.1
content-type: application/json

### agregar un producto (categoria se indica por su id)
POST http://localhost:8080/producto HTTP/1.1
content-type: application/json

{
  "nombre": "Cupcake Red Velvet",
  "descripcion": "Cupcake de Red Velvet con crema por dentro.",
  "precio": 2190,
  "imagen": "/img/cupcake.png",
  "stock": 20,
  "stockCritico": 5,
  "oferta": 0,
  "destacado": false,
  "categoria": { "idCategoria": 3 }
}

### obtener todos los retiros en tienda
GET http://localhost:8080/retiro-tienda HTTP/1.1
content-type: application/json

### agregar un retiro en tienda
POST http://localhost:8080/retiro-tienda HTTP/1.1
content-type: application/json

{
  "numeroOrden": "20261119-0001",
  "nombreRetira": "Roman Julian",
  "correo": "roman@duocuc.cl",
  "sucursal": "Mil Sabores La Florida",
  "fecha": "2026-11-25",
  "hora": "15:30",
  "estado": "pendiente"
}

### actualizar un retiro en tienda
PUT http://localhost:8080/retiro-tienda/1 HTTP/1.1
content-type: application/json

{
  "nombreRetira": "Camila Rojas Soto",
  "correo": "camila@duocuc.cl",
  "sucursal": "Mil Sabores La Florida",
  "fecha": "2026-11-25",
  "hora": "16:00",
  "estado": "listo"
}

### eliminar un retiro en tienda
DELETE http://localhost:8080/retiro-tienda/1 HTTP/1.1

### obtener todos los delivery
GET http://localhost:8080/delivery HTTP/1.1
content-type: application/json

